# Produção.  cp .env.example .env  e preencha tudo o que está sem valor.
# Dica: ./deploy.sh secrets   → gera valores aleatórios para as chaves abaixo.

# --- Domínio ---
DOMAIN=riendzo.co.mz
# Endereço completo do site (com https://). Entra nos links dos e-mails/SMS, nos QR Codes e no CORS da API.
SITE_URL=https://riendzo.co.mz

# --- Base de dados ---
POSTGRES_USER=riendzo
POSTGRES_PASSWORD=
POSTGRES_DB=riendzo

# --- Segurança (todas obrigatórias, valores longos e diferentes entre si) ---
JWT_SECRET=
SERVICE_API_KEY=
ADMIN_SESSION_SECRET=
SETTINGS_SECRET=

# --- Conta principal do BackOffice (/admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- E-mail (opcional agora; também se configura no BackOffice > Administrador > Configurações) ---
CONTACT_EMAIL=
RESEND_API_KEY=
MAIL_FROM="Riendzo <no-reply@riendzo.co.mz>"

# --- Redes sociais (rodapé e barra do topo; deixe vazio para esconder) ---
SOCIAL_FACEBOOK=https://facebook.com/riendzo
SOCIAL_INSTAGRAM=https://instagram.com/riendzo
SOCIAL_YOUTUBE=https://youtube.com/@riendzo
SOCIAL_TIKTOK=https://tiktok.com/@riendzo
SOCIAL_WHATSAPP=
SOCIAL_X=
SOCIAL_LINKEDIN=

# --- Doações: M-Pesa Open API (Vodacom Moçambique) ---
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
# "live" em produção; qualquer outro valor = sandbox
MPESA_ENV=sandbox

# Transferência manual por M-Pesa: aparece por baixo do botão "Efetuar Pagamento" quando os pagamentos online
# ainda não estão ativos. Número M-Pesa que recebe (ex.: 84 123 4567) e o nome que aparece ao enviar.
# Se o número estiver vazio, esta opção não é mostrada.
DONATE_MANUAL_MPESA_NUMBER=
DONATE_MANUAL_MPESA_NAME=

# Subscrições Premium: o mesmo painel de transferência manual (número para copiar). Se ficarem vazias,
# usam-se DONATE_MANUAL_MPESA_*. O pedido fica "pending" até o administrador aprovar.
SUBSCRIBE_MANUAL_MPESA_NUMBER=
SUBSCRIBE_MANUAL_MPESA_NAME=