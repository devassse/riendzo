# BackOffice (/admin): copy to .env.local and set real values
ADMIN_USERNAME=admin
ADMIN_PASSWORD=riendzo-admin
# 32+ random characters, e.g.:  openssl rand -base64 48
ADMIN_SESSION_SECRET=GkLA89sK2OXfzF+II8uyayRre99k7Qr5fCm1b+LEQPM++qMJllWAD8ZhhI+xCTBX

# Public address of the site (QR codes, share links and the links in e-mails/SMS).
# In development use http://localhost:3000; in production the real address (https://riendzo.co.mz)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the Contactos page (optional)
CONTACT_EMAIL=contact@riendzo.com

# --- Riendzo API (Node/Express + PostgreSQL) ---
# Deixe vazio para continuar a usar os ficheiros locais em data/.
# Com a API a correr (cd ../riendzo-api && npm run dev):
RIENDZO_API_URL=http://localhost:4000
# Mesmo valor de SERVICE_API_KEY no .env da API (24+ caracteres). Necessário para criar/editar conteúdo.
RIENDZO_API_KEY=MMNZxux+8JRC5TAUXpxPDL1gEenBoL6q9P1oVLFzFyo8mEqh

# --- E-mail (recuperação de palavra-passe) ---
# https://resend.com (opcional: sem isto, em desenvolvimento o link aparece na consola do servidor)
RESEND_API_KEY=
MAIL_FROM="Riendzo <no-reply@riendzo.co.mz>"

# --- Redes sociais (rodapé e barra do topo). Deixe "" para esconder uma rede. ---
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/riendzo
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/riendzo
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@riendzo
NEXT_PUBLIC_SOCIAL_TIKTOK=https://tiktok.com/@riendzo
NEXT_PUBLIC_SOCIAL_WHATSAPP=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# --- Configurações de e-mail/SMS feitas no BackOffice (Administrador > Configurações) ---
# Chave que cifra as chaves guardadas (32+ caracteres). Em produção defina uma e não a mude depois.
SETTINGS_SECRET=
# Opcional: aceder ao site em desenvolvimento por IPs fora de 192.168.x.x / 10.x.x.x (separados por vírgula)
DEV_ORIGINS=

# --- Verificação de conta (código por e-mail ou SMS) ---
# Só em desenvolvimento, sem e-mail/SMS configurados: o código aparece na consola do servidor e numa caixa
# amarela na página de verificação. Opcional: um código fixo de 6 dígitos para testar sempre com o mesmo.
# Ignorado em produção.
DEV_VERIFY_CODE=

# --- Doações: M-Pesa Open API (Vodacom Moçambique) ---
# Credenciais do Developer Portal (https://developer.mpesa.vm.co.mz). Sem elas, em desenvolvimento o pagamento é SIMULADO
# (nada é debitado); em produção os pagamentos ficam desativados.
MPESA_API_KEY=
# Chave pública do portal (base64 ou PEM): serve para cifrar a API key
MPESA_PUBLIC_KEY=
# Código do serviço (shortcode) que recebe o dinheiro
MPESA_SERVICE_PROVIDER_CODE=
# "live" em produção; qualquer outro valor = sandbox
MPESA_ENV=sandbox
