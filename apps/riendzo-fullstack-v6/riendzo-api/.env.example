# Copie para .env e ajuste.   cp .env.example .env

# --- Base de dados (docker compose up -d db) ---
DATABASE_URL="postgresql://riendzo:riendzo@localhost:5432/riendzo?schema=public"

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Origens do frontend autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000
# Atrás de um proxy/Nginx/Render/Railway: 1
TRUST_PROXY=0

# --- Segurança ---
# 32+ caracteres:  openssl rand -base64 48   (em desenvolvimento há um valor por defeito)
JWT_SECRET=
# Chave usada pelo servidor do frontend (Next.js) para gerir conteúdo. 24+ caracteres.
# Tem de ser igual a RIENDZO_API_KEY no frontend.   openssl rand -base64 36
SERVICE_API_KEY=

# --- Conta principal do BackOffice (igual ao frontend) ---
ADMIN_USERNAME=admin
# Em desenvolvimento, se ficar vazio, usa "riendzo-admin". Em produção é obrigatória.
ADMIN_PASSWORD=

# --- Ficheiros carregados ---
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=15

# --- E-mail (recuperação de palavra-passe) ---
# Endereço público do site (os links dos e-mails apontam para aqui)
SITE_URL=http://localhost:3000
# https://resend.com (opcional: sem isto, em desenvolvimento o e-mail aparece na consola)
RESEND_API_KEY=
MAIL_FROM="Riendzo <no-reply@riendzo.co.mz>"
