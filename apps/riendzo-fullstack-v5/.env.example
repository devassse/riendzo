# Produção.  cp .env.example .env  e preencha tudo o que está sem valor.
# Dica: ./deploy.sh secrets   → gera valores aleatórios para as chaves abaixo.

# --- Domínio ---
DOMAIN=riendzo.co.mz
# Endereço completo do site (com https://). Entra nos links dos e-mails/SMS, nos QR Codes e no CORS da API.
SITE_URL=https://riendzo.co.mz

# --- Base de dados ---
POSTGRES_USER=riendzo
POSTGRES_PASSWORD=
POSTGRES_DB=riendzo

# --- Segurança (todas obrigatórias, valores longos e diferentes entre si) ---
JWT_SECRET=
SERVICE_API_KEY=
ADMIN_SESSION_SECRET=
SETTINGS_SECRET=

# --- Conta principal do BackOffice (/admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- E-mail (opcional agora; também se configura no BackOffice > Administrador > Configurações) ---
CONTACT_EMAIL=
RESEND_API_KEY=
MAIL_FROM="Riendzo <no-reply@riendzo.co.mz>"

# --- Redes sociais (rodapé e barra do topo; deixe vazio para esconder) ---
SOCIAL_FACEBOOK=https://facebook.com/riendzo
SOCIAL_INSTAGRAM=https://instagram.com/riendzo
SOCIAL_YOUTUBE=https://youtube.com/@riendzo
SOCIAL_TIKTOK=https://tiktok.com/@riendzo
SOCIAL_WHATSAPP=
SOCIAL_X=
SOCIAL_LINKEDIN=
