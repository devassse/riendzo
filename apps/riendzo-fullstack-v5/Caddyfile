# HTTPS automático (Let's Encrypt) para o domínio definido em DOMAIN no .env.
# O DNS do domínio tem de apontar para o IP do servidor e as portas 80 e 443 têm de estar abertas.
{$DOMAIN} {
	encode zstd gzip

	# vídeo do hero e outros ficheiros carregados (o site limita-se a 60 MB)
	request_body {
		max_size 70MB
	}

	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}

# www → domínio principal
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
